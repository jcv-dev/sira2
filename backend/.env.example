# Copy to .env and fill in your SIRA credentials.
# NOTE: .env is gitignored. Never commit real credentials.

SIRA_BASE_URL=https://sira1.univalle.edu.co/sra
SIRA_USERNAME=your-code-here
SIRA_PASSWORD=your-password-here

# Seconds to cache upstream responses (keeps load off the prod server).
SIRA_CACHE_TTL_SECONDS=300

# Upstream request timeout in seconds.
SIRA_TIMEOUT_SECONDS=30

# Optional: protect this API with a bearer token. Leave empty to disable.
# SIRA_API_TOKEN=change-me

# Comma-separated origins allowed to call the API from a browser.
SIRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
